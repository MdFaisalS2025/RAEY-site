# Copy to .env.local and fill in. Never commit .env.local.

# Resend (https://resend.com) — powers the "Request demo" form.
# Without this set, the form still works but degrades honestly: it shows a
# real error naming the fallback contact email instead of faking success.
RESEND_API_KEY=

# Where demo requests get sent. Must be a verified sender/domain in Resend.
DEMO_REQUEST_TO_EMAIL=
DEMO_REQUEST_FROM_EMAIL=

# Public site origin, used to resolve OG/canonical URLs. Falls back to
# localhost in dev — safe to leave unset until the real domain is live.
NEXT_PUBLIC_SITE_URL=
